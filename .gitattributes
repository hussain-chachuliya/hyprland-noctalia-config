# hypr/noctalia.lua is auto-generated by Noctalia; its color block (lines 3-9)
# is rewritten on every wallpaper change. The "clean" filter below normalizes
# those values to rgb(000000) before git hashes the file, so the whole file
# stays tracked while the volatile colors stay out of the repo.
#
# One-time setup per clone. Run it from the repo root so the shell expands
# $PWD (the current directory) to the repo root -- double quotes matter, they
# make the shell expand $PWD now rather than storing the literal string:
#   git config filter.noctalia-colors.clean    "$PWD/git-filters/noctalia-clean.sh"
#   git config filter.noctalia-colors.smudge    cat
#   git config filter.noctalia-colors.required true
# The smudge line is NOT optional: with required=true and no smudge program,
# git dies whenever it has to write this file (clone/checkout/reset/rebase):
#   fatal: hypr/noctalia.lua: smudge filter noctalia-colors failed
# Or just use the absolute path, e.g. /home/hussain/.config/git-filters/noctalia-clean.sh
hypr/noctalia.lua filter=noctalia-colors
